#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Launches codium-server (VSCodium reh-web) as the abc user.
#
# Port 3000 is deliberate: the LinuxServer base exposes 8000, but keeping 3000
# means VSCODE_CONTAINER_PORT and the control plane need no changes.
#
# This override intentionally drops the upstream run script's CONNECTION_TOKEN /
# CONNECTION_TOKEN_FILE / CODE_ARGS handling — auth is the control plane's
# proxy, not a connection token.
#
# --server-data-dir, not --user-data-dir: unpatched upstream codium-server
# parses --user-data-dir but unconditionally overwrites it with
# <server-data-dir>/data (src/vs/server/node/server.main.ts). openvscode-server
# only honoured --user-data-dir via a Gitpod patch. --server-data-dir ${HOME}
# yields /config/data/{User,Machine} — the same layout init-frc-setup seeds.
#
# --reconnection-grace-time 30: a reloaded or removed editor iframe never
# disconnects cleanly, so its extension host (and Java language server, ~1 GB
# with Gradle) otherwise lingers for the 3 h default. Every project switch
# remounts the iframe. A client away longer than 30 s reloads the editor.

EXTENSIONS_DIR="${HOME}/extensions"

codium_args=(
  --host 0.0.0.0
  --port 3000
  --without-connection-token
  --disable-telemetry
  --disable-workspace-trust
  --extensions-dir "${EXTENSIONS_DIR}"
  --server-data-dir "${HOME}"
  --reconnection-grace-time 30
)

if [[ -n "${VSCODE_BASE_PATH:-}" && "${VSCODE_BASE_PATH:-/}" != "/" ]]; then
  codium_args+=(--server-base-path "${VSCODE_BASE_PATH}")
fi

exec \
  s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 3000" \
    cd /app/vscodium-web s6-setuidgid abc \
      /app/vscodium-web/bin/codium-server \
        "${codium_args[@]}" \
        /workspace/project
